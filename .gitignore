# Ignore OS-specific files
.DS_Store

# Ignore dependency directories (node_modules, etc.)
node_modules/
frontend/node_modules/
backend/node_modules/

# Ignore build-related and temporary files
frontend/.angular/
mongodb/
mongodb-linux-x86_64-2.2.7/
ngrok-stable-linux-amd64.zip

# Ignore Conda environment artifacts
[conda

# Ignore sensitive or unnecessary data files
studentsInfo.xlsx

# Ignore logs and temporary files
*.log
*.tmp
*.swp

# Allow .gitignore itself
!.gitignore

# Allow essential files and directories
!package.json
!package-lock.json
!backend/package-lock.json
!backend/src/
!frontend/src/
!start_portal.sh
